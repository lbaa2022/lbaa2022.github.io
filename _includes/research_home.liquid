    <div class="research-home-domains">{% for domain in site.data.research.vertical_axes %}<a href="{{ '/research/' | relative_url }}?vertical={{ domain.id }}#research-results"><span>0{{ forloop.index }} / 적용 분야</span>{{ domain.label }} ↗</a>{% endfor %}</div>

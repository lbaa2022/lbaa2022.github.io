{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LBA Research Outcome Registry",
  "type": "object",
  "required": [
    "schema_version",
    "coverage",
    "records",
    "source_claims",
    "summary",
    "status_definitions",
    "verification_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "coverage": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "source_claim_ids",
          "verification",
          "metadata_issues",
          "project_attribution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "paper",
              "patent",
              "software_registration"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "reported_years": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 2022,
              "maximum": 2025
            }
          },
          "verification": {
            "type": "object",
            "required": [
              "status",
              "checked_at",
              "basis",
              "evidence",
              "attempts"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "preprint_only",
                  "candidate",
                  "unconfirmed",
                  "pending_registration",
                  "not_checked"
                ]
              },
              "checked_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "url",
                    "source",
                    "match",
                    "checked_at"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^https://"
                    }
                  }
                }
              },
              "attempts": {
                "type": "array"
              }
            }
          },
          "project_contribution": {
            "type": "object",
            "required": [
              "percent",
              "status",
              "observation_ids",
              "selected_observation_ids",
              "checked_at"
            ],
            "properties": {
              "percent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "status": {
                "enum": [
                  "reported",
                  "reported_and_corroborated",
                  "explicit_in_paper",
                  "conflicting_values",
                  "percentage_not_stated",
                  "grant_not_found_in_available_text",
                  "full_text_unavailable",
                  "paper_with_report_difference",
                  "paper_with_version_difference"
                ]
              }
            }
          },
          "citations": {
            "type": "object",
            "required": [
              "provider",
              "citation_count",
              "status",
              "checked_at",
              "aggregation_owner_id"
            ],
            "properties": {
              "provider": {
                "const": "OpenAlex"
              },
              "citation_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "status": {
                "enum": [
                  "matched",
                  "not_found",
                  "ambiguous",
                  "access_error",
                  "review_rejected"
                ]
              },
              "checked_at": {
                "type": "string"
              },
              "aggregation_owner_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "matched"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "citation_count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "work_id",
                    "match_method"
                  ]
                },
                "else": {
                  "properties": {
                    "citation_count": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "source_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "outcome_id",
          "source_type",
          "title",
          "details",
          "reference"
        ],
        "properties": {
          "source_type": {
            "enum": [
              "report",
              "project_site"
            ]
          }
        }
      }
    },
    "citation_summary": {
      "type": "object"
    },
    "citation_policy": {
      "type": "object"
    }
  }
}
